{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-esi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Match Cloudflare Dashboard: custom domain only (no *.workers.dev / preview URLs)
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  }
  // SITE_PASSWORD / other secrets: do NOT put in `vars` here (would commit to git).
  // Local: .dev.vars  |  Production: `npx wrangler secret put SITE_PASSWORD`
}
